{
  "name": "frontline-knowledge-agent",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "node scripts/dev.mjs --preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "tsx": "4.21.0",
    "vite": "^7.3.0"
  }
}
