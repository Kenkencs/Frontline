# Configure only the providers you want to use. Demo models need no keys.
# Copy to .env locally. The Node backend loads it; hosted keys are runtime secrets.
# Never rename secret keys to VITE_*: Vite exposes those variables to the browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
# KIMI_API_KEY must be issued by the global Kimi/Moonshot platform (api.moonshot.ai).
